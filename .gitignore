# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Ruby
/ruby/.bundle/
/ruby/vendor/bundle/
/ruby/pkg/
/ruby/tmp/
/ruby/coverage/
/ruby/.yardoc/
/ruby/doc/
# Gemfile.lock is gitignored for libraries/gems (this is a gem).
# If ruby/ ever becomes an application, remove this line.
/ruby/Gemfile.lock
*.gem

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local agent / tooling state
.claude/
.codegraph/
.cursor/

# Internal-only operational docs (non-public endpoints)
docs/ops/

# Runtime / machine-specific state — never commit
/data/
*.db
# Per-user vault config is generated by the tool (stores absolute local paths).
# The committed demo vault keeps only keys + the .example template.
robocap-vault/customer_config.json
